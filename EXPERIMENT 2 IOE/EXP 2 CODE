import numpy as np
import matplotlib.pyplot as plt

# Simulation parameters
packet_size = 1500 * 8  # 1500 bytes converted to bits

# Data rate in Mbps
data_rate = np.linspace(0.5, 20, 100)

# Standard transmission delay formula
# Delay (ms) = Packet size (bits) / Data rate (bits/s) * 1000

transmission_delay = packet_size / (data_rate * 1e6) * 1000

# Illustrative fixed delay components in milliseconds
# These values are assumptions for simulation, not universal constants

# Edge
edge_propagation = 1
edge_processing = 2
edge_queueing = 0.5

# Fog
fog_propagation = 5
fog_processing = 4
fog_queueing = 1.5

# Cloud
cloud_propagation = 20
cloud_processing = 8
cloud_queueing = 3

# Total end-to-end delay
edge_delay = (
    transmission_delay + edge_propagation
    + edge_processing + edge_queueing
)

fog_delay = (
    transmission_delay + fog_propagation
    + fog_processing + fog_queueing
)

cloud_delay = (
    transmission_delay + cloud_propagation
    + cloud_processing + cloud_queueing
)

# Plot results
plt.figure(figsize=(9, 5))

plt.plot(data_rate, edge_delay, label="Edge")
plt.plot(data_rate, fog_delay, label="Fog")
plt.plot(data_rate, cloud_delay, label="Cloud")

plt.xlabel("Data Rate (Mbps)")
plt.ylabel("End-to-End Time Delay (ms)")
plt.title("IoE Framework: Time Delay vs Data Rate")

plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()
